#!/bin/bash
# CPU-only configure for CompressHpMGARDOperator (Frontier login/compute nodes, CCE 21).
# Usage (from a fresh build directory inside or next to the repo):
#   mkdir build_cpu && cd build_cpu && source ../runconf_cpu && make -j16 && cmake --install .
#
# Dependencies: OpenMP, libzstd (system or the MGARD prefix), optional MGARD-X (SERIAL build) for the
# `mgardx` stream codec and the direct-MGARD-X tuner candidate, optional ADIOS2 for the plugin.
set -e
# The Cray wrapper auto-links libsci (static TLS: breaks dlopen of the plugin) and darshan (MPI-only);
# neither is needed, so unload them for the whole configure + build shell.
if type module >/dev/null 2>&1; then module unload cray-libsci darshan-runtime 2>/dev/null || true; fi
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="${HPMGARD_INSTALL_DIR:-${PROJECT_DIR}/install-cpu}"
MGARD_DIR="${MGARD_DIR:-/lustre/orion/cfd164/proj-shared/gongq/Software/MGARD-serial/install-serial}"
ADIOS2_DIR="${ADIOS2_DIR:-/lustre/orion/cfd164/proj-shared/gongq/Software/ADIOS2/install-adios-serial}"

cmake -S "${PROJECT_DIR}" -B "$(pwd)" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="${CMAKE_C_COMPILER:-cc}" \
  -DCMAKE_CXX_COMPILER="${CMAKE_CXX_COMPILER:-CC}" \
  -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR}" \
  -DCMAKE_INSTALL_RPATH="${MGARD_DIR}/lib64;${MGARD_DIR}/lib;${ADIOS2_DIR}/lib64" \
  -DHPMGARD_ENABLE_MGARDX=ON \
  -Dmgard_DIR="${MGARD_DIR}/lib64/cmake/mgard" \
  -DHPMGARD_BUILD_ADIOS2_PLUGIN="${HPMGARD_BUILD_ADIOS2_PLUGIN:-ON}" \
  -DADIOS2_DIR="${ADIOS2_DIR}/lib64/cmake/adios2" \
  -DCMAKE_PREFIX_PATH="${MGARD_DIR};${ADIOS2_DIR}"

echo ""
echo "Configured. Build with 'make -j16', install with 'cmake --install .' -> ${INSTALL_DIR}"
echo "Runtime: export ADIOS2_PLUGIN_PATH=${INSTALL_DIR}/lib64"
