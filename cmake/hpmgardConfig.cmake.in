@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(OpenMP COMPONENTS CXX)
find_dependency(ZSTD)
set(HPMGARD_HAVE_MGARDX @mgard_FOUND@)
if(HPMGARD_HAVE_MGARDX)
  find_dependency(mgard CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/hpmgardTargets.cmake")
check_required_components(hpmgard)
