#!/bin/bash
# HIP (AMD GPU) configure for CompressHpMGARDOperator on Frontier (gfx90a). Host code: CCE `CC`, device
# code: ROCm clang through CMake's HIP language.
#   mkdir build_hip && cd build_hip && source ../runconf_hip && make -j16 && cmake --install .
set -e
if type module >/dev/null 2>&1; then
  module load rocm/7.2.0 2>/dev/null || true
  module unload cray-libsci darshan-runtime craype-accel-amd-gfx90a 2>/dev/null || true
fi
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="${HPMGARD_INSTALL_DIR:-${PROJECT_DIR}/install-hip}"
MGARD_DIR="${MGARD_DIR:-/lustre/orion/cfd164/proj-shared/gongq/Software/MGARD/install-hip-frontier.mgard17}"
ADIOS2_DIR="${ADIOS2_DIR:-/lustre/orion/cfd164/proj-shared/gongq/Software/ADIOS2/install-adios-serial}"
ROCM="${ROCM_PATH:-/opt/rocm-7.2.0}"
cmake -S "${PROJECT_DIR}" -B "$(pwd)" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="${CMAKE_C_COMPILER:-cc}" \
  -DCMAKE_CXX_COMPILER="${CMAKE_CXX_COMPILER:-CC}" \
  -DCMAKE_HIP_COMPILER="${ROCM}/lib/llvm/bin/clang++" \
  -DCMAKE_HIP_ARCHITECTURES=gfx90a \
  -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR}" \
  -DCMAKE_INSTALL_RPATH="${MGARD_DIR}/lib64;${MGARD_DIR}/lib;${ADIOS2_DIR}/lib64;${ROCM}/lib" \
  -DHPMGARD_ENABLE_HIP=ON \
  -DHPMGARD_ENABLE_MGARDX=ON \
  -Dmgard_DIR="${MGARD_DIR}/lib64/cmake/mgard" \
  -DHPMGARD_BUILD_ADIOS2_PLUGIN="${HPMGARD_BUILD_ADIOS2_PLUGIN:-ON}" \
  -DADIOS2_DIR="${ADIOS2_DIR}/lib64/cmake/adios2" \
  -DCMAKE_PREFIX_PATH="${MGARD_DIR};${ADIOS2_DIR};${ROCM}"
echo "Configured for HIP. make -j16 && cmake --install . -> ${INSTALL_DIR}; run with device=hip (or auto on a GPU node)."
